# Operator-local settings, copied outside the checkout by init.py.
# Must match the canonical HTTPS origin rendered in config/ingress/Caddyfile.
PUBLIC_SITE_URL=https://library.example.invalid
PUBLIC_SHARING_ENABLED=false
PUBLIC_SHARE_URL=
ARSENAL_LOG_JSON=true

# Safe fixture default: no paid calls; mock does not implement remix generation.
AI_PROVIDER=mock
# Optional overrides (or corresponding *_FILE); blank inherits the global provider.
# Global mock with a live override sends data to that operation's provider.
CLASSIFICATION_PROVIDER=
CLASSIFICATION_STYLE_GUIDANCE=
REMIX_STYLE_GUIDANCE=
EMBEDDING_PROVIDER=
REMIX_PROVIDER=
ONLINE_EMBEDDINGS_ENABLED=false

# For a real provider, select compatible models and put only its key in secrets/.
# AI_PROVIDER=google
# GEMINI_API_KEY_FILE=/run/secrets/gemini_api_key
# AI_MODEL=gemini-2.5-flash
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSIONS=768
# Or AI_PROVIDER=openai with OPENAI_API_KEY_FILE=/run/secrets/openai_api_key.
# Telegram credentials are read only by the explicit telegram profile.
