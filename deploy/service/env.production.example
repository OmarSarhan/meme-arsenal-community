# Legacy external-proxy example; fresh installs start at deploy/community/README.md.
# Copy outside the checkout to your instance's config/service.env and set
# SERVICE_ENV_FILE to that absolute path for every Compose command.

APP_ENV=production
ARSENAL_LOG_JSON=true

# These bind-mount directories must exist on the mounted storage volume.
RESERVE_HOST_PATH=/srv/my-library/state/reserve
POSTGRES_DATA_HOST_PATH=/srv/my-library/state/postgres-data
REDIS_DATA_HOST_PATH=/srv/my-library/state/redis-data
# All seven named secret files must exist here; never commit their contents.
SERVICE_SECRETS_DIR=/srv/my-library/secrets

PUBLIC_SITE_URL=https://library.example.net
# Enable only after DNS and the share-only proxy are live.
# PUBLIC_SHARE_URL=https://share.example.net
PUBLIC_SESSION_COOKIE_SECURE=true
PUBLIC_SESSION_DAYS=180
PUBLIC_TRUST_PROXY_HEADERS=true
PUBLIC_ITEMS_DEFAULT_LIMIT=96
PUBLIC_ITEMS_MAX_LIMIT=240
PUBLIC_REMIX_JOBS_PER_HOUR=16
PUBLIC_REMIX_ANALYSES_PER_HOUR=16
PUBLIC_WRITE_ACTIONS_PER_MINUTE=60
PUBLIC_MAX_ACTIVE_REMIX_JOBS=2
PUBLIC_UPLOAD_MAX_MB=128
BROWSER_PLAYBACK_BACKFILL_BATCH_SIZE=4
REMIX_JOB_STALE_SECONDS=3600

POSTGRES_DB=meme_arsenal
POSTGRES_USER=meme_arsenal

AI_PROVIDER=google
AI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
ONLINE_EMBEDDINGS_ENABLED=false
REMIX_MODEL=gemini-3.1-flash-image
REMIX_ASPECT_RATIO=1:1
REMIX_IMAGE_SIZE=1K
REMIX_INCLUDE_VIDEO_ORIGINAL=true
REMIX_VIDEO_INLINE_MAX_MB=20

AI_REQUEST_DELAY_SECONDS=4
AI_MAX_RETRIES=3
AI_MAX_RETRY_DELAY_SECONDS=90
AI_STOP_ON_RATE_LIMIT=true
AI_CREDIT_PROBE_INTERVAL_SECONDS=21600
AI_CREDIT_PROBE_LEASE_SECONDS=300
AI_RECOVERY_BATCH_SIZE=5
AI_INCLUDE_VIDEO_ORIGINAL=false
AI_VIDEO_INLINE_MAX_MB=20

IMPORT_BATCH_SIZE=100
IMPORT_DELAY_SECONDS=0.35
MAX_VIDEO_KEYFRAMES=8
SEMANTIC_SEARCH_TOP_K=25

SYNC_INTERVAL_SECONDS=1200
SYNC_START_DELAY_SECONDS=30
