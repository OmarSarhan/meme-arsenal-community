RESERVE_PATH=./meme-arsenal-reserve
DATABASE_URL=sqlite:///${RESERVE_PATH}/data/arsenal.sqlite

# Telegram credentials from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Use "mock" for deterministic local tests, "openai" or "google" for live AI.
# For AI_PROVIDER=openai, set OPENAI_API_KEY.
# For AI_PROVIDER=google, set GEMINI_API_KEY, GOOGLE_API_KEY, or AI_API_KEY.
AI_PROVIDER=mock
# Optional per-operation overrides; blank inherits AI_PROVIDER. *_FILE also works.
# Model names and dimensions remain explicit; live overrides send data remotely.
CLASSIFICATION_PROVIDER=
CLASSIFICATION_STYLE_GUIDANCE=
REMIX_STYLE_GUIDANCE=
EMBEDDING_PROVIDER=
REMIX_PROVIDER=
OPENAI_API_KEY=
AI_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CLASSIFICATION_PROMPT_VERSION=v1
REMIX_MODEL=gemini-3.1-flash-image
REMIX_ASPECT_RATIO=1:1
REMIX_IMAGE_SIZE=1K
REMIX_INCLUDE_VIDEO_ORIGINAL=true
REMIX_VIDEO_INLINE_MAX_MB=20

# Leave blank for the provider default. Google classification defaults to 4s
# pacing because Gemini free-tier RPM quotas are low.
AI_REQUEST_DELAY_SECONDS=
AI_MAX_RETRIES=3
AI_MAX_RETRY_DELAY_SECONDS=90
AI_STOP_ON_RATE_LIMIT=true
AI_CREDIT_PROBE_INTERVAL_SECONDS=21600
AI_CREDIT_PROBE_LEASE_SECONDS=300
AI_RECOVERY_BATCH_SIZE=5
AI_INCLUDE_VIDEO_ORIGINAL=true
AI_VIDEO_INLINE_MAX_MB=20

IMPORT_BATCH_SIZE=100
IMPORT_DELAY_SECONDS=0.35
MAX_VIDEO_KEYFRAMES=8
SEMANTIC_SEARCH_TOP_K=25
# Public publication is explicit opt-in; URL alone never enables it.
PUBLIC_SHARING_ENABLED=false
